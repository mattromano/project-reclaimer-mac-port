<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.projectreclaimer.loopback</string>
  <key>ProgramArguments</key>
  <array><string>/Library/Application Support/ProjectReclaimer/reclaimer-loopback.sh</string></array>
  <!-- no RunAtLoad: it runs when the launcher asks, by changing this folder (only the player's account can write it;
       the sandboxed game can't), and at most once every five minutes -->
  <key>WatchPaths</key>
  <array><string>/Library/Application Support/ProjectReclaimer/request</string></array>
  <key>ThrottleInterval</key><integer>300</integer>
</dict>
</plist>
